1 24 "app.manifest"
2 ICON "app.ico"

1 VERSIONINFO
FILEVERSION 2,3,2,0
PRODUCTVERSION 2,3,2,0
FILEOS 0x4
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "ProductName", "Win-Dock"
      VALUE "FileDescription", "Win-Dock - lanceur d'applications"
      VALUE "FileVersion", "2.3.2.0"
      VALUE "ProductVersion", "2.3.2.0"
      VALUE "InternalName", "WinDock"
      VALUE "OriginalFilename", "WinDock.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
