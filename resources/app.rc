1 24 "app.manifest"
2 ICON "app.ico"

1 VERSIONINFO
FILEVERSION 2,1,0,0
PRODUCTVERSION 2,1,0,0
FILEOS 0x4
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "ProductName", "RocketDock Modern"
      VALUE "FileDescription", "RocketDock Modern - lanceur d'applications"
      VALUE "FileVersion", "2.1.0.0"
      VALUE "ProductVersion", "2.1.0.0"
      VALUE "InternalName", "RocketDockModern"
      VALUE "OriginalFilename", "RocketDockModern.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
